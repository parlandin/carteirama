POSTGRES_DB=carteirama
POSTGRES_USER=carteirama
POSTGRES_PASSWORD=change_me

# Portas expostas no host (opcionais)
HTTP_PORT=8080
DB_PORT=5432
ADMINER_PORT=8081
DATABASUS_PORT=4005

# E-mail pela Resend (opcional). Sem chave, os e-mails só aparecem no log da API.
# Use uma chave "Sending access" restrita ao seu domínio (resend.com/api-keys).
RESEND_API_KEY=
# onboarding@resend.dev só entrega para o e-mail da sua conta Resend; com o domínio
# verificado, use algo como: Carteirama <nao-responda@mail.seudominio.com.br>
EMAIL_FROM=Carteirama <onboarding@resend.dev>

# Endereço público do front, usado nos links de e-mail e de pagamento
FRONTEND_URL=http://localhost:8080

# Gateway de pagamento: none (desligado) ou abacatepay
PAYMENT_PROVIDER=none
# Chave da AbacatePay (dashboard > Integrar > Chaves de API), com as permissões
# TRANSPARENT:CREATE e TRANSPARENT:READ. Chave do Modo Teste para testar.
ABACATEPAY_API_KEY=
# O mesmo segredo cadastrado no webhook da AbacatePay (32 caracteres ou mais).
# Gere com: openssl rand -hex 32
ABACATEPAY_WEBHOOK_SECRET=
